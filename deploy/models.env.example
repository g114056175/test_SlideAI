# Copy to deploy/models.env. This file is ignored by Git.
#
# Use docker for a clean portable deployment, or native to reuse existing
# Ubuntu Python runtimes without duplicating many GB inside an image.
SLIDEAI_DEPLOY_MODE=docker
VOXTTS_RUNTIME_PYTHON_HOST_PATH=
VOXTTS_RUNTIME_PYTHON_CONTAINER=/opt/slideai/voxcpm/bin/python
QWEN_SPEECH_RUNTIME_PYTHON_HOST_PATH=
VIDEO_ABSTRACT_LOCAL_ONLY=true
VIDEO_ABSTRACT_MOCK_MODE=false

# Existing local model directories take priority. They may live anywhere on
# the host and are mounted read-only into fixed container paths.
VOXTTS_MODEL_HOST_PATH=./models/tts/VoxCPM2
QWEN3_ASR_MODEL_HOST_PATH=./models/asr/Qwen3-ASR-1.7B
QWEN3_ALIGNER_MODEL_HOST_PATH=./models/alignment/Qwen3-ForcedAligner-0.6B
QWEN3_TTS_MODEL_HOST_PATH=./models/tts/Qwen3-TTS-12Hz-1.7B-Base

# Providers and tunable runtime settings.
SLIDEAI_TTS_PROVIDER=voxcpm
SLIDEAI_ASR_PROVIDER=qwen3
SLIDEAI_ALIGNMENT_PROVIDER=qwen3
VOXTTS_ENGINE=original
# Build the additional Nano-vLLM environment only after explicitly selecting
# acceleration in slideai.sh.  It adds another CUDA/Torch runtime layer.
VOXTTS_INSTALL_NANO=0
# Qwen3 TTS is an optional fallback and needs a separate environment because
# it pins a different Transformers patch release from Qwen3 ASR.
QWEN3_TTS_INSTALL=0
VOXTTS_NANO_TIMESTEPS=12
VOXTTS_NANO_GPU_MEMORY_UTILIZATION=0.50
VOXTTS_NANO_IDLE_TIMEOUT_SEC=120
QWEN3_ALIGNMENT_IDLE_TIMEOUT_SEC=60

# Optional download fallback. It is used only when the corresponding path
# above is not a valid model directory.
#
# Supported source formats:
#   https://server/path/model.tar.zst
#   https://server/path/model.tar.gz
#   https://server/path/model.zip
#   hf:organization/model-repository
#   /absolute/path/to/an/existing/model-directory
VOXCPM2_SOURCE=hf:openbmb/VoxCPM2
QWEN3_ASR_SOURCE=hf:Qwen/Qwen3-ASR-1.7B
QWEN3_ALIGNER_SOURCE=hf:Qwen/Qwen3-ForcedAligner-0.6B
QWEN3_TTS_SOURCE=hf:Qwen/Qwen3-TTS-12Hz-1.7B-Base
