# Copy to backend/.env. Never commit real credentials.
api_key=
LLM_PROVIDER=
GOOGLE_GENERATIVE_MODEL=gemini-2.5-flash
# Global per-backend limit shared by all users and all LLM providers.
LLM_MAX_CONCURRENCY=3
# Optional OpenAI-compatible local/vendor endpoint.
# CUSTOM_LLM_ENDPOINT=http://127.0.0.1:8081/v1/chat/completions
# CUSTOM_LLM_MODEL=local-model-alias
# CUSTOM_LLM_API_KEY=
SECRET_KEY=replace-with-a-long-random-value

VIDEO_ABSTRACT_LOCAL_ONLY=true
VIDEO_ABSTRACT_MOCK_MODE=false
THREAD_COUNT=1

# Optional exact/regex CORS overrides for a custom public hostname. Private
# localhost/LAN addresses are accepted by default.
# FRONTEND_URL=https://slideai.example.com
# CORS_ALLOW_ORIGIN_REGEX=^https://slideai\.example\.com$

# Default local database; Docker overrides this with an absolute container path.
DATABASE_URL=sqlite:///./data/database/slideai.sqlite3
